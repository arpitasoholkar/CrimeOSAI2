# Copy to .env and fill in to use real Google Maps tiles/markers in the
# Geographic Intelligence panel instead of the default OpenStreetMap/Leaflet
# view. Entirely optional -- the map works with zero configuration without
# this, since Leaflet + OpenStreetMap needs no API key.
#
# Get a key at https://console.cloud.google.com/google/maps-apis
# (enable the "Maps JavaScript API").
VITE_GOOGLE_MAPS_API_KEY=
